<?xml version="1.0" encoding="utf-8"?>
<!--
  展开后的操作条底板：胶囊形。

  半透明深色 + 斜向渐变（上亮下暗）+ 亮边。系统浮窗不能模糊背后，
  所以「玻璃感」全靠这层渐变和描边撑起来，不能是一块纯色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#7A14181A"
        android:startColor="#A62A3033"
        android:type="linear" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
